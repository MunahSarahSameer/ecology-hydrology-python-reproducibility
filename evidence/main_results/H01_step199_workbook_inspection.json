  "script": {
    "path": "Data and codes/codes/Fig. 2_monthly_streamflow.py",
    "source": "import pandas as pd\r\nimport matplotlib.pyplot as plt\r\nimport numpy as np\r\n\r\nplt.rcParams[\"font.family\"] = \"Times New Roman\"\r\nplt.rcParams[\"font.size\"] = 10\r\n\r\ndef calculate_nse(observed, simulated):\r\n    if len(observed) == 0 or len(simulated) == 0:\r\n        return np.nan\r\n    observed_mean = observed.mean()\r\n    numerator = ((observed - simulated) ** 2).sum()\r\n    denominator = ((observed - observed_mean) ** 2).sum()\r\n    if denominator == 0:\r\n        return np.nan\r\n    return 1 - numerator / denominator\r\n\r\nsimulated = pd.read_excel('E:/All1study/1irragation/compute/逐月径流模拟结果_天然.xlsx', index_col=0)\r\nsimulated_human = pd.read_excel('E:/All1study/1irragation/compute/逐月径流模拟结果_人类.xlsx', index_col=0)\r\nobserved = pd.read_excel('E:/All1study/1irragation/compute/逐月实测径流数据绘图.xlsx', index_col=0)\r\n\r\ndef annual_nse(observed, simulated):\r\n    df = pd.concat([observed, simulated], axis=1)\r\n    df.columns = ['Observed', 'Simulated']\r\n    annual_nse_values = df.resample('Y').apply(lambda x: calculate_nse(x['Observed'], x['Simulated']))\r\n    return annual_nse_values\r\n\r\ndef calculate_period_nse(observed, simulated, start_year, end_year):\r\n    start_date = f\"{start_year}-01-01\"\r\n    end_date = f\"{end_year}-12-31\"\r\n    observed_period = observed.loc[start_date:end_date]\r\n    simulated_period = simulated.loc[start_date:end_date]\r\n    return calculate_nse(observed_period, simulated_period)\r\n\r\n\r\ncommon_sites = simulated.columns.intersection(observed.columns)\r\n\r\nnum_sites = len(common_sites)\r\nnum_cols = 2\r\nnum_rows = int(np.ceil(num_sites / num_cols))\r\n\r\nfig_width = 10\r\nfig_height = 20\r\nplt.figure(figsize=(fig_width, fig_height))\r\n\r\nend_date = pd.to_datetime('2022-12-31')\r\n\r\nfor i, site in enumerate(common_sites, start=1):\r\n    ax1 = plt.subplot(num_rows, num_cols, i)\r\n    \r\n    obs = observed[site].dropna()\r\n    sim = simulated[site]\r\n    sim_human = simulated_human[site]\r\n    \r\n    ax1.plot(obs.index, obs, label='OBS', linestyle='--', color='black', linewidth=0.5)\r\n    ax1.plot(sim.index, sim, label='NAT', color='blue', linewidth=0.5)\r\n    ax1.plot(sim_human.index, sim_human, label='HUM', color='red', linewidth=0.5)\r\n\r\n    ax1_min, ax1_max = ax1.get_ylim()\r\n    ax1.set_ylim(ax1_min, ax1_max + (ax1_max - ax1_min) * 0.5)\r\n    ax1.set_xlabel(site.title(), labelpad=0)\r\n    ax1.set_xlim(obs.index.min(), end_date)\r\n    ax1.tick_params(axis='y', labelcolor='black')\r\n\r\n    ax2 = ax1.twinx()  \r\n    nse_values_natural = annual_nse(obs, sim)\r\n    nse_values_human = annual_nse(obs, sim_human)\r\n    \r\n    ax2.plot(nse_values_natural.index, nse_values_natural, linestyle='--', marker='o', color='blue', markersize=1, linewidth=1, label='NSE (NAT)')\r\n    ax2.plot(nse_values_human.index,nse_values_human, linestyle='--', marker='^', color='red', markersize=1, linewidth=1, label='NSE (HUM)')\r\n    \r\n    periods = [(1991, 2000), (2001, 2012), (2013, 2022)]\r\n    for period in periods:\r\n        avg_nse_natural = calculate_period_nse(obs, sim, *period)\r\n        avg_nse_human = calculate_period_nse(obs, sim_human, *period)\r\n        print(f\"{site} ({period[0]}-{period[1]}): NAT={avg_nse_natural}, HUM={avg_nse_human}\")\r\n    \r\n    ax2_min, ax2_max = ax2.get_ylim()\r\n    ax2.set_ylim(ax2_min - (ax2_max - ax2_min)*2.5, 1)\r\n    ax2.tick_params(axis='y', labelcolor='black')\r\n\r\n    nse_values = annual_nse(observed[site].dropna(), simulated[site])\r\n    min_nse_value = min(nse_values.min(), -1)\r\n    \r\n    if site == 'xiantao':      \r\n        ax2.set_yticks([-100, 1])\r\n        ax2.set_yticklabels([f'{-100:.0f}', '1'])\r\n    else:\r\n        ax2.set_yticks([min_nse_value, 1])\r\n        ax2.set_yticklabels([f'{min_nse_value:.0f}', '1'])        \r\n\r\n    lines, labels = ax1.get_legend_handles_labels()\r\n    lines2, labels2 = ax2.get_legend_handles_labels()\r\n\r\nplt.subplots_adjust(hspace=0.3, wspace=0.1)\r\nplt.tight_layout(pad=3.0)\r\nplt.show()"
  },
